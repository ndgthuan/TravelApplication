# Copy this file to .env and fill in your keys. Do not commit .env.

# OpenRouteService – routing (map directions)
OPENROUTE_SERVICE_API_KEY=your_openrouteservice_api_key_here

# Currency exchange API (e.g. exchangerate-api.com)
CURRENCY_TOKEN=your_currency_api_key_here

# Email support (e.g. EmailJS) – optional
# SERVICE_ID=
# TEMPLATE_ID=
# PUBLIC_KEY=
# PRIVATE_KEY=
