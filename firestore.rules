rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- users/{userId} (profile: displayName, email, avatar...) ---
    // Đọc: mọi user đã đăng nhập (để hiện danh sách mời thành viên); ghi: chỉ chính user đó.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

      // Địa điểm đã lưu (home - saved destinations)
      match /saved_destinations/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- users/{userId}/plan_created/{planId} ---
    // Plan của owner (userId = owner). Cho phép đọc/ghi nếu: chủ plan, email trong memberEmails, hoặc có plan_shared ref (đã chấp nhận lời mời).
    // Cho phép update thêm: email trong pendingInviteEmails (khi chấp nhận).
    function isPlanOwnerOrMember(userId, planData) {
      return request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email in planData.get('memberEmails', [])
      );
    }
    function hasSharedAccess(userId, planId) {
      let ref = get(/databases/$(database)/documents/users/$(request.auth.uid)/plan_shared/$(planId));
      return request.auth != null && ref != null && ref.data != null && ref.data.get('ownerId') == userId;
    }
    function isPendingInvitee(planData) {
      return request.auth != null &&
        request.auth.token.email in planData.get('pendingInviteEmails', []);
    }

    match /users/{userId}/plan_created/{planId} {
      allow read, delete: if isPlanOwnerOrMember(userId, resource.data) || hasSharedAccess(userId, planId);
      allow update: if isPlanOwnerOrMember(userId, resource.data) || hasSharedAccess(userId, planId) || isPendingInvitee(resource.data);
      allow create: if request.auth != null && request.auth.uid == userId;

      match /activity_created/{activityId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email in get(/databases/$(database)/documents/users/$(userId)/plan_created/$(planId)).data.get('memberEmails', []) ||
          hasSharedAccess(userId, planId)
        );
      }
    }

    // --- users/{userId}/plan_shared/{planId} ---
    // Ref tham chiếu plan được share; chỉ user đó đọc/ghi.
    match /users/{userId}/plan_shared/{planId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- plan_invites (collection gốc) ---
    // Đọc: chỉ người nhận (toUserId). Tạo: chỉ người gửi (fromUserId). Cập nhật: chỉ người nhận (accept/decline).
    match /plan_invites/{inviteId} {
      allow read: if request.auth != null && resource.data.toUserId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUserId == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // --- plan_presence/{roomId}/viewers/{viewerId} ---
    // Presence theo phòng (roomId = ownerId_planId). Mỗi user chỉ ghi doc viewers/{chính mình}; đọc để hiển thị "A, B đang trong chuyến đi".
    match /plan_presence/{roomId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /viewers/{viewerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == viewerId;
        allow delete: if request.auth != null && request.auth.uid == viewerId;
      }
    }
  }
}
